global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'node_exporters'
    static_configs:
      - targets:
          - "{{ hostvars['frontend']['ansible_host'] }}:9100"
          - "{{ hostvars['backend']['ansible_host'] }}:9100"
          - "{{ hostvars['database']['ansible_host'] }}:9100"
          - "{{ hostvars['reverse_proxy']['ansible_host'] }}:9100"
