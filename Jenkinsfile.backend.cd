pipeline {
    agent {label 'Linux'}

    environment {
        GITHUB_URL="https://github.com/Andriy29k/intern_project01.git"
    }

    stages {
        stage('Checkout branch') {
            steps {
                git branch: 'dev',
                    url: "${env.GITHUB_URL}",
                    credentialsId: 'github-credentials'
            }
        }

        stage ('Ansible') {
            steps {
                dir('ansible') {
                   sh 'ansible-playbook -i inventory.ini site.yml --tags backend'
                }
            }
        }
    }
}
