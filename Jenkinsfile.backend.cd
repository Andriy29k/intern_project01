pipeline {
    agent {label 'Linux'}

    environment {
        GITHUB_URL="https://github.com/Andriy29k/intern_project01.git"
    }

    stages {
        stage('Checkout branch') {
            steps {
                git branch: 'dev',
                    url: "${env.GITHUB_URL}",
                    credentialsId: 'github-credentials'
            }
        }

        stage ('Ansible') {
            steps {
                dir('ansible') {
                    // dir('files') {
                    //     sh 'bash generate_inventory.sh'
                    // }
                    sh 'ansible all -i inventory.ini -m ping'
                }
            }
        }
    }
}
